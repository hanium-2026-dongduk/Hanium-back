datasource db {
  provider = "mysql" 
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. 동화책 기본 정보 (stories)
model Story {
  id            Int         @id @default(autoincrement())
  userId        Int?        // A 개발자 로그인 연동 전까지 optional
  childProfileId Int?       // 2주차 자녀 프로필 연동 대비 (optional)
  title         String      @db.VarChar(255)
  coverImageUrl String?     @db.Text
  status        String      @default("PROCESSING") // PROCESSING, COMPLETED, FAILED

  pages         StoryPage[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("stories")
}

// 2. 동화 각 페이지 정보 (story_pages)
model StoryPage {
  id         Int      @id @default(autoincrement())
  storyId    Int
  pageNumber Int
  content    String   @db.Text // Gemini가 생성한 본문 텍스트
  imageUrl   String?  @db.Text // 삽화 이미지 URL (SG02)
  audioUrl   String?  @db.Text // TTS 오디오 URL (SG05)

  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("story_pages")
}