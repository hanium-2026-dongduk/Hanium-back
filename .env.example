PORT=3000

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# 이메일 (Gmail 앱 비밀번호 사용 권장)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 프록시(Nginx) 뒤에서 돌 때만 true. 로컬 개발에서는 비워둔다.
TRUST_PROXY=

# CORS 허용 출처(쉼표 구분). 비우면 전체 허용.
CORS_ORIGINS=
