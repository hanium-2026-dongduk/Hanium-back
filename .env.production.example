# 운영 환경변수 템플릿 (EC2용).
#
#   cp .env.production.example .env
#
# ⚠️ .env 는 gitignore 대상이다. 절대 커밋하지 말 것.

# NODE_ENV=production 이면 JWT 시크릿이 비어 있을 때 서버가 뜨지 않는다(src/config/env.js).
# 개발 기본값이 운영에 새어 들어가는 것을 막기 위한 의도된 동작이다.
NODE_ENV=production
PORT=3000

# ── DB (RDS) ─────────────────────────────────────────────────────────
# 엔드포인트는 AWS 콘솔 → RDS → 데이터베이스 → 연결 및 보안 탭에 있다.
# EC2에서 붙으려면 RDS 보안그룹 인바운드(3306)에 **EC2의 보안그룹 ID**를 허용해야 한다.
# (IP가 아니라 보안그룹으로 여는 편이 안전하고, EC2 IP가 바뀌어도 유지된다)
DB_HOST=xxxxx.xxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=hanium
DB_USER=admin
DB_PASSWORD=

# ── 이메일 ────────────────────────────────────────────────────────────
# 회원가입 인증번호와 비밀번호 재설정에 쓴다.
#
# Gmail을 쓴다면 2단계 인증을 켜고 "앱 비밀번호"를 발급받아야 한다(계정 비밀번호가 아니다).
# EC2에서 Gmail SMTP가 막히는 경우가 있는데, 그때는 AWS SES로 바꾼다
# (SES는 도메인 인증이 필요하고, 샌드박스 해제 전에는 인증된 주소로만 보낼 수 있다).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ── JWT ──────────────────────────────────────────────────────────────
# 아래로 각각 새로 생성해서 넣는다. 개발용 값을 그대로 쓰면 안 된다.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# 이 값을 바꾸면 발급돼 있던 모든 토큰이 무효가 되어 전원 재로그인해야 한다.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 보안 ─────────────────────────────────────────────────────────────
# Nginx 뒤에서 돌 때 반드시 true. 켜지 않으면 rate limit이 모든 요청을 Nginx 하나의
# IP로 보고 전체 사용자를 함께 막는다. 반대로 프록시 없이 켜면 클라이언트가
# X-Forwarded-For를 위조해 제한을 우회할 수 있으므로, 프록시가 있을 때만 켠다.
TRUST_PROXY=true

# CORS 허용 출처(쉼표 구분). 비워두면 전체 허용이다.
# 앱이 브라우저에서 돌지 않는 동안은 비워둬도 되지만, 웹 클라이언트나 관리자 페이지가
# 생기면 반드시 채운다.
CORS_ORIGINS=
